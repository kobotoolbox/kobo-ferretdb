# Read automatically by `docker compose`, so that a plain `docker compose up`
# brings up the whole demo. Upstream kobo-docker expects the front-end and
# back-end files to be run as two separate projects on two hosts; here they are
# merged into one project sharing one network.
COMPOSE_FILE=docker-compose.backend.yml:docker-compose.frontend.yml
COMPOSE_PROJECT_NAME=kobo-ferretdb
